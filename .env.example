# Copiar a .env (no se sube al repo) y completar. Lo lee docker-compose.yml.

# Base de datos PostgreSQL (la crea el contenedor `db`)
DB_NAME=gastromind_db
DB_USER=postgres
DB_PASSWORD=cambia-esta-clave

# MISMO secreto para Spring (firma el JWT) y Django (lo verifica). Al menos 32 caracteres.
# Generar uno: openssl rand -hex 32
JWT_SECRET=

# Clave interna de Django. Generar una: openssl rand -hex 32
DJANGO_SECRET_KEY=

# Correo de las alertas y de la bienvenida (HU-01-b, HU-04, HU-16). Vacío = no se envían correos.
# Para la demo con el Gmail del proyecto: smtp.gmail.com, 587 y una contraseña de aplicación.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Carpeta del repo de Django, si no está al lado de este con el nombre por defecto
# DJANGO_DIR=../GastroMind-Django
