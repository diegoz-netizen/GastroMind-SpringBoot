# Conexión a la base de datos PostgreSQL local
spring.datasource.url=jdbc:postgresql://localhost:5432/gastromind_db
spring.datasource.username=postgres
spring.datasource.password=TU_PASSWORD_AQUI

# Configuración Hibernate / JPA
# Sin ddl-auto aquí: vale el validate de application.properties (si se pone update, lo pisa).
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.PostgreSQLDialect

# JWT Configuration
# secret: obligatoria, al menos 32 bytes (HS256) y la MISMA que JWT_SECRET de Django. Si falta o es corta, Spring no arranca.
# expiration-ms: opcional, por defecto 24 h (86400000).
gastromind.jwt.secret=TU_JWT_SECRET_AQUI
gastromind.jwt.expiration-ms=86400000

# HU-04: SMTP de Mailtrap (Email Testing > Inboxes > SMTP). Mejor como variables de entorno:
#   export MAIL_USERNAME=... MAIL_PASSWORD=...
# spring.mail.username=TU_USUARIO_MAILTRAP
# spring.mail.password=TU_PASSWORD_MAILTRAP
